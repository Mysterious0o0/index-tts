# ClickHouse（A 服务器）
CLICKHOUSE_HOST=your_server_a_ip
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=b_writer
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_DB=audio_db

# 阿里云 OSS
OSS_REGION=your_oss_region
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_AUDIO_PREFIX=depthVoice/

# TTS 模型路径
TTS_CFG_PATH=/data/nvme2/model/IndexTeam/IndexTTS-2/config.yaml
TTS_MODEL_DIR=/data/nvme2/model/IndexTeam/IndexTTS-2/
TTS_PROMPT_WAV_DIR=/root/code/index-tts/examples/gen

# 音频临时目录（B 服务器本地）
AUDIO_TEMP_DIR=/data/audio/temp

# A 服务器日志接口
LOG_FETCH_URL=http://your_server_a_ip/logs/daily
LOG_FETCH_TOKEN=your_token

# A 服务器索引重建接口
SERVER_A_REBUILD_URL=http://your_server_a_ip/internal/index/rebuild
SERVER_A_REBUILD_TOKEN=your_internal_token

# 跨域白名单（A 服务器地址）
CORS_ORIGINS=http://your_server_a_ip
